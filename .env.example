# 模型提供方：kimi / kimi-intl / qwen / siliconflow / openai / ollama
LLM_PROVIDER=kimi

# 必填：你的 API Key
MOONSHOT_API_KEY=

#（ 可选覆盖）
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2.6
# LLM_API_KEY=

# LLM_TEMPERATURE=1

# 上传图像的最长边，超过会自动等比缩小（单位：像素）
IMAGE_MAX_EDGE=1536

# 服务端口
GRADIO_SERVER_PORT=7860
